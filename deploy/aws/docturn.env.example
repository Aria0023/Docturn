# DocTurn — production environment template.
#
# DO NOT copy this file to the server and fill it in by hand. On AWS the real
# file (/etc/docturn/docturn.env, mode 0640 root:docturn) is RENDERED from SSM
# Parameter Store by deploy/aws/fetch-env-from-ssm.sh, so secrets never live in
# git, shell history or an AMI. This template documents every variable the
# server reads (grep -r "process.env" server/) and which ones are required.
#
# Values marked (SSM) are stored as SecureString under /docturn/prod/<NAME>.

# ── Required ────────────────────────────────────────────────────────────────

# Marks the session cookie Secure and enables production behaviour.
NODE_ENV=production

# RDS connection string (SSM). Presence of this variable switches the app from
# the in-process PGlite to real Postgres — /api/health then reports
# persistent:true, storage:"postgres" — and moves the session store to Postgres
# too (table `session`, created automatically), so restarts and deploys do not
# sign anyone out. Keep sslmode=require.
DATABASE_URL=postgresql://docturn:CHANGE_ME@docturn-db.xxxx.us-east-1.rds.amazonaws.com:5432/docturn?sslmode=require

# Session-cookie signing key, 64 hex chars (SSM). Without it the server makes a
# random one per boot and every restart logs everyone out.
SESSION_SECRET=CHANGE_ME_64_HEX

# Real-PHI mode: refuses to seed the shared demo org/accounts and keeps AI on
# the local stub. Set to "false" for any deployment that will hold real data.
SYNTHETIC_DATA=false

# Provisions (and on later boots, rotates) the cross-tenant operator account
# `dev` on org code DOCTURN. MUST be 12+ characters — shorter values are
# refused and the account is simply not created. (SSM)
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_LONG_PASSPHRASE

# Attachments (images, documents, voice messages) as AES-256-GCM files, never
# plaintext, never inline in the database.
ATTACHMENT_STORE=fs-encrypted
ATTACHMENT_DIR=/var/lib/docturn/attachments
# 32-byte key as 64 hex chars (SSM). Losing this key makes every attachment
# unrecoverable — keep an offline copy. Rotation is a re-encryption job, not
# an env change.
ATTACHMENT_KEY=CHANGE_ME_64_HEX

# Encryption key for each hospital's OWN integration credentials (Amion OCS
# feed, Epic backend app) saved in Settings → Integrations: AES-256-GCM at rest.
# 64 hex chars (`openssl rand -hex 32`) or any secret of 32+ characters (SSM
# SecureString /docturn/prod/INTEGRATION_KEY). Without it the app refuses to
# save hospital credentials (nothing is ever stored in plaintext); everything
# else works. Keep an offline copy: if it is lost or changed, saved hospital
# credentials read as "can't be decrypted" and directors must re-enter them
# (no patient data depends on it).
# It ALSO encrypts each hospital's single-sign-on client secret
# (Settings → Security → Single sign-on, module enterprise.sso): without it a
# director cannot save an SSO connection at all.
INTEGRATION_KEY=CHANGE_ME_64_HEX

# ── Recommended ─────────────────────────────────────────────────────────────

# The absolute URL browsers reach this deployment on, used where DocTurn has
# to hand an ABSOLUTE url to someone else and must not trust the Host header:
# the single-sign-on redirect URI a hospital registers with its identity
# provider (/api/auth/sso/callback) and the SCIM base URL shown to a director
# (/scim/v2). Unset, both are derived from the request, which is right behind
# an ordinary reverse proxy and wrong behind one that rewrites the host.
# No trailing slash.
# PUBLIC_BASE_URL=https://docturn.example.org

# LAB ONLY — never on a deployment that handles real patient data. Lets a
# single-sign-on issuer be http://127.0.0.1… so a local TEST identity
# provider can be used (scripts/sso-check.mjs, or a pilot in a lab). It is
# ignored outright when NODE_ENV=production, warned about on the boot log,
# shown on the director's card, and it relaxes nothing else: any other issuer
# URL still must be https on a public address.
# SSO_ALLOW_INSECURE_ISSUER=1

# Shown in the UI and in notifications.
APP_NAME=DocTurn

# Web push for the PWA (content-free notifications). Generate once with
# `npx web-push generate-vapid-keys`. Without these the server generates a pair
# on first boot and stores it in the database (platform org settings) — push
# still works, but the private key then lives in the database instead of SSM.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# ── Leave at defaults in production (documented so nobody "fixes" them) ─────

# PORT=3000            Caddy proxies to 127.0.0.1:3000; only change it together
#                      with the Caddyfile.
# INSTANCE_ID=         Unset → host-pid-random. Names this process in the
#                      job_leases table, on realtime-bus frames and in the
#                      developer console's cluster view. Set it (e.g. the EC2
#                      instance id) when running more than one instance.
# SHUTDOWN_TIMEOUT_MS= Unset → 10000. How long SIGTERM waits for in-flight
#                      requests before cutting them. Keep it below the unit's
#                      TimeoutStopSec (20 s).
# HOST=                Unset → 127.0.0.1 under NODE_ENV=production: the Node port
#                      answers only on loopback, i.e. only Caddy on this host can
#                      reach it. Correct for this topology — do not set 0.0.0.0
#                      here (that is for platforms such as Render that connect to
#                      the process over the network).
# TRUST_PROXY=         Unset → "loopback": X-Forwarded-For / X-Forwarded-Proto
#                      are believed only from a peer on this host (Caddy), one
#                      hop. That gives correct client IPs (rate limits, audit
#                      rows) and lets the Secure session cookie be set. Accepted
#                      values: unset/1/true = loopback; 0/false = trust nothing
#                      (behind Caddy every sign-in is then refused with
#                      insecure_transport — fetch-env-from-ssm.sh refuses it);
#                      or a comma list of IPs, CIDRs and the keywords loopback,
#                      linklocal, uniquelocal for a proxy on ANOTHER host. A bare
#                      hop count >= 2 works but is spoofable and logged as such.
#                      Check: curl https://<domain>/api/health → "secure":true.
# RATE_LIMIT=on        Defaults ON. NEVER set "off" in production — it disables
#                      the brute-force control and the compliance monitor flags it.
# STAT_REALERT_MS=     Optional tuning of the STAT re-alert / escalate timers.
# STAT_ESCALATE_MS=

# ── Platform integrations — set ONLY when you connect them ─────────────────
# Each one shows in Settings → Integrations with its live status; every
# organization can switch it off for itself there. docs/INTEGRATIONS.md has
# the step-by-step. After adding/changing any of them in SSM:
#   REGION=<region> bash /opt/docturn/deploy/aws/fetch-env-from-ssm.sh && systemctl restart docturn
# then press "Test connection" on the card.

# Twilio SMS (STAT nudges, escalation texts, SMS sign-in codes; texts are
# content-free, no PHI). Unset → SMS is UNAVAILABLE under NODE_ENV=production:
# SMS one-time codes and /api/sms/send answer 503 sms_unavailable and SMS
# escalation is skipped (logged, content-free). Nothing is sent, billed or
# reported as sent. MFA is TOTP / backup codes (free).
# TWILIO_ACCOUNT_SID=  AC… (SecureString)
# TWILIO_AUTH_TOKEN=   (SecureString)
# TWILIO_FROM_NUMBER=  +15551234567 (E.164)
#
# OpenAI intake extraction. Intake notes ARE PHI: AI intake uses the
# deterministic LOCAL extractor unless a key is set AND you explicitly
# acknowledge a signed BAA with OpenAI via AI_EXTERNAL_PHI_OK=true. Without a
# BAA leave all of these unset.
# OPENAI_API_KEY=      (SecureString)
# AI_EXTERNAL_PHI_OK=  true — ONLY after OpenAI has signed a BAA with you
# USE_STUB_AI=         true forces the local extractor everywhere (leave unset)
#
# DEMO_PASSWORD=       Demo-only; ignored in real-PHI mode.
# PGLITE_DIR=          Only used when DATABASE_URL is absent.

# ── Organization integrations (each hospital connects its own) ─────────────
# Amion and Epic are connected PER HOSPITAL by its director in Settings →
# Integrations → Set up (stored encrypted with INTEGRATION_KEY). The variables
# below are the older one-organization fallback, used only for the org named
# by *_ORG_CODE and only when that org has saved nothing of its own.

# AMION_OCS_URL=            Amion on-call grid (module schedule.amion)
# AMION_ORG_CODE=
# AMION_SYNC_INTERVAL_MIN=  default 240 (applies to every org's pull)
# EPIC_FHIR_BASE_URL=       Epic on-call via FHIR R4 (module schedule.epic,
# EPIC_CLIENT_ID=           default OFF). Needs Epic app registration.
# EPIC_PRIVATE_KEY_PEM=
# EPIC_TOKEN_URL=
# EPIC_ORG_CODE=
# EPIC_SYNC_INTERVAL_MIN=   default 60 (applies to every org's pull)
